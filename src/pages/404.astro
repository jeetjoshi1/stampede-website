---
import BaseLayout from "../layouts/BaseLayout.astro";
import Patch from "../components/Patch.astro";
import Wheel from "../components/Wheel.astro";
import Icon from "../components/Icon.astro";
---
<BaseLayout title="Lost signal" description="This page could not be found." noindex>
  <section class="section lost">
    <div class="container lost-inner">
      <Patch size="160px" decorative id="lost" />
      <h1 class="lost-title">Lost signal.</h1>
      <p class="lede">We couldn't find that page. It may have moved, or the link may be wrong.</p>
      <p class="telemetry lost-tel"><Wheel size={20} spin label="Searching" /> ERR 404 · no carrier</p>
      <a class="btn btn-primary" href="/">Back to home <Icon name="arrow-right" /></a>
    </div>
  </section>
</BaseLayout>

<style>
  .lost-inner { display: grid; justify-items: center; text-align: center; gap: 20px; padding-block: 32px; }
  .lost-inner :global(.patch) { margin: 40px; }
  .lost-tel { display: inline-flex; align-items: center; gap: 8px; color: var(--text-muted); margin: 0; }
  .lost-tel :global(.wheel) { color: var(--accent); }
  .lost-title { font-size: clamp(38px, 6vw, 64px); }
</style>
